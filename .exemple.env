# =============================================================================
# Configurações da aplicação Spring Boot
# =============================================================================
# Nome da aplicação
SPRING_APPLICATION_NAME=Site

# Porta do servidor
SERVER_PORT=8080

# =============================================================================
# Configurações do MongoDB
# =============================================================================
# URL de conexão com o MongoDB (incluindo autenticação e replicaSet, caso necessário)
MONGODB_URI=mongodb://root:root@localhost:27017/?authSource=admin&replicaSet=rs0

# Nome do banco de dados MongoDB
MONGODB_DATABASE=anime

# =============================================================================
# Configurações do JWT (JSON Web Token)
# =============================================================================
# Chave secreta usada para assinar o JWT (alterar para uma chave segura)
JWT_SECRET=sua_chave_secreta

# Tempo de expiração do JWT em minutos (ex: 10 minutos)
JWT_EXPIRATION=10

# Tempo de expiração do refresh token em minutos (ex: 15 minutos)
JWT_REFRESH=15

# =============================================================================
# Configurações do RabbitMQ
# =============================================================================
# Host onde o RabbitMQ está rodando (pode ser localhost ou um IP)
RABBITMQ_HOST=localhost

# Porta padrão do RabbitMQ
RABBITMQ_PORT=5672

# Usuário do RabbitMQ (usuário padrão: guest)
RABBITMQ_USERNAME=asd

# Senha do RabbitMQ (senha padrão: guest)
RABBITMQ_PASSWORD=awd

# Virtual host padrão do RabbitMQ
RABBITMQ_VIRTUAL_HOST=/

# =============================================================================
# Configurações para Docker (caso a aplicação e os serviços estejam rodando no Docker)
# =============================================================================
# URL do MongoDB no Docker (se estiver usando o Docker, altere localhost para 'mongo')
# Exemplo: MONGODB_URI=mongodb://root:root@mongo:27017/?authSource=admin&replicaSet=rs0
DOCKER_MONGODB_URI=mongodb://mongo:27017/?authSource=admin&replicaSet=rs0

# Host do RabbitMQ no Docker (se estiver usando o Docker, altere localhost para 'rabbitmq')
# Exemplo: RABBITMQ_HOST=rabbitmq
DOCKER_RABBITMQ_HOST=rabbitmq

# =============================================================================
# IMPORTANTE: NÃO DEIXE O ARQUIVO .env EXPOSTO EM REPOSITÓRIOS PÚBLICOS!
# =============================================================================
